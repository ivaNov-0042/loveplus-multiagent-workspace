# LovePlus+ 逆向工程项目的本地路径配置（复制为 .env 后填入本机真实路径）
# 真实 .env 已被 .gitignore 忽略，切勿提交；本文件是占位模板，可安全提交。

# 仓库根目录：填本机上这份仓库的绝对路径（不填时 common_paths.py 会退回「脚本所在目录向上两级」推断）
LOVEPLUS_REPO=/abs/path/to/this/repo

# 无头模拟器可执行文件
AZAHAR_HEADLESS=${LOVEPLUS_REPO}/tools/azahar/build_headless/bin/Release/azahar_headless

# GUI（Qt）模拟器可执行文件（scripts/loveplus/run_gui.sh 使用）
AZAHAR_QT=${LOVEPLUS_REPO}/tools/azahar/build_qt/bin/Release/azahar

# 游戏 ROM（已 patch）
NLP_PLUS_ROM=${LOVEPLUS_REPO}/data/loveplus/roms_patched/NLP_plus_patched.3ds

# 解压后的 .text（code.bin 经 LZSS 解压）
NLP_CODE_UNPACKED=${LOVEPLUS_REPO}/data/loveplus/nlp_plus/code_text_unpacked.bin

# 原始压缩 code.bin（ExeFS）
NLP_CODE_BIN=${LOVEPLUS_REPO}/data/loveplus/nlp_plus/code.bin

# 模拟器控制/调试相关（可改端口）
EMU_LIVE_PORT=24777
EMU_GDB_PORT=24689
EMU_DUMP_PREFIX=/tmp/az_live

# 远端仓库主机（供 scripts/loveplus/sync_from_txnew.sh 拉取用；ssh 别名或 host）
LOVEPLUS_REMOTE=tx-new

# ── Git 提交身份（本仓库 local config 用）──
# 推荐 GitHub noreply 邮箱，避免个人邮箱进公开提交记录
LOCAL_GIT_NAME=your-name
LOCAL_GIT_EMAIL=your-name@users.noreply.github.com
